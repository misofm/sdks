{
  "name": "@misofm/musicos",
  "version": "0.5.0",
  "packageManager": "bun@1.4.0",
  "description": "A sui-effect extension for the Miso object model (Composition, Recording, Release, Track): the Musicos service, PTB fragments, event decoders, and BCS codecs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misofm/sdks.git"
  },
  "homepage": "https://github.com/misofm/sdks#readme",
  "bugs": {
    "url": "https://github.com/misofm/sdks/issues"
  },
  "keywords": [
    "sui",
    "move",
    "miso",
    "music",
    "blockchain",
    "sdk",
    "object-model",
    "composition",
    "recording",
    "release"
  ],
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "docs": "typedoc",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "rm -rf dist && tsc -p tsconfig.build.json --noCheck"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./deployments": {
      "types": "./dist/deployments.d.ts",
      "default": "./dist/deployments.js"
    },
    "./queries": {
      "types": "./dist/queries.d.ts",
      "default": "./dist/queries.js"
    },
    "./transactions": {
      "types": "./dist/transactions.d.ts",
      "default": "./dist/transactions.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./parsers": {
      "types": "./dist/parsers.d.ts",
      "default": "./dist/parsers.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./packages": {
      "types": "./dist/packages.d.ts",
      "default": "./dist/packages.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "default": "./dist/contracts/*.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "AGENTS.md",
    "LLMS.md",
    "LICENSE",
    "package.json"
  ],
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@mysten/bcs": "2.1.1",
    "@mysten/sui": "2.29.0",
    "@types/bun": "^1.4.0",
    "@unconfirmed/sui-effect": "0.2.0",
    "effect": "4.0.0-rc.112",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@mysten/bcs": "^2.1.1",
    "@mysten/sui": "^2.28",
    "@unconfirmed/sui-effect": ">=0.1.0 <0.3.0",
    "effect": ">=4.0.0-rc.112 <4.1",
    "typescript": "^5.7 || ^6 || ^7"
  },
  "main": "./dist/index.js"
}
