{
  "extends": "./tsconfig.json",
  "include": ["src"],
  "exclude": ["tests"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM"],
    "rootDir": "src",
    "outDir": "dist"
  }
}
