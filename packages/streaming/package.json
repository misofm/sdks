{
  "name": "@misofm/streaming",
  "version": "0.3.0",
  "packageManager": "bun@1.4.0",
  "description": "The miso-hls/v1 streaming transcode contract (rendition ladder, segment policy, Quilt item naming) plus a browser player for Miso streams.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misofm/sdks.git",
    "directory": "packages/streaming"
  },
  "homepage": "https://github.com/misofm/sdks#readme",
  "bugs": {
    "url": "https://github.com/misofm/sdks/issues"
  },
  "keywords": [
    "miso",
    "hls",
    "aac",
    "walrus",
    "streaming"
  ],
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "default": "./dist/player.js"
    },
    "./warm": {
      "types": "./dist/warm.d.ts",
      "default": "./dist/warm.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "rm -rf dist && tsc -p tsconfig.build.json --noCheck"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112",
    "hls.js": "^1.6"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "effect": "4.0.0-rc.112",
    "hls.js": "1.6.13",
    "typescript": "^7.0.2"
  }
}
